<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="index.master.cs" Inherits="san_lun_hotel.index1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <link href="css/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="css/dist/js/bootstrap.bundle.min.js"></script>
    <script src="css/dist/js/bootstrap.bundle.min.js"></script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <style>
        .bd-placeholder-img {
            font-size: 1.125rem;
            text-anchor: middle;
            -webkit-user-select: none;
            -moz-user-select: none;
            user-select: none;
        }

        .nav {
            background-color: #ffffff;
            color: orange;
        }

        .nav-link {
            font-weight: bold;
        }

        .pic {
            background-attachment: fixed;
            background-size: 100% 100%;
        }

        .dz {
            line-height: 40px;
        }

        #grzx {
            position: fixed;
            top: 35px;
            left: 8px;
            z-index: 19;
            border: none;
            outline: none;
            color: white;
            cursor: pointer;
            border-radius: 1px;
            width: 18px;
            padding: 15px 0;
            text-decoration: none;
            font-size: 10px;
        }

        .grzx {
            padding-top: -30px;
            /*  padding-left:125px;*/
            margin: 0 auto;
            color: red;
        }

        .offcanvas-start {
            width: 320px;
      
        }

        .sjh {
            margin: 0 auto;
            text-align: center;
           line-height:40px;
           font-size:20px;
           
        }

        .pic {
            width: 50px;
            height: 50px;
            margin: 0 auto;
            
          
        }
        .bottom{
          
        }
        .sanlunimg{
            width:20px;
            height:20px;
        }
      
         a{
          text-decoration:none;
      }
        @media (min-width: 768px) {
            .bd-placeholder-img-lg {
                font-size: 3.5rem;
            }
        }
    </style>
    <link rel="icon" href="ico/三轮饭店.ico">
    <link href="css/materialdesignicons.min.css" rel="stylesheet" />
    <script src="css/dist/js/bootstrap.bundle.min.js"></script>
    <link href="css/dist/css/bootstrap.min.css" rel="stylesheet" />

</head>
<body>
    <form id="form1" runat="server" method="post">
        <div>
            <div>
                <!-- Nav pills -->
                <ul class="nav  row fixed-top text-black" role="tablist">
                    <li class="nav-item col-sm-1">
                        <a href="zhuye.aspx">
                            <img src="img/三轮图标透明.png" alt="logo" style="width: 35px;">
                        </a>
                    </li>

                    <li class="nav-item col-sm-2 q">
                        <a class="nav-link active link-danger  " href="dontai.aspx"><i class="mdi mdi-meteor">店铺动态</i></a>
                    </li>
                    <li class="nav-item col-sm-2 q">
                        <a class="nav-link link-danger" href="dingcan.aspx"><i class="mdi mdi-rice">订 餐</i></a>
                    </li>
                    <li class="nav-item col-sm-2 q">
                        <a class="nav-link link-danger" href="baoxaing.aspx"><i class="mdi mdi-home-outline">预订包厢</i></a>
                    </li>
                    <li class="nav-item col-sm-2 q">
                        <a class="nav-link link-danger" href="liuyan.aspx"><i class="mdi mdi-comment-account-outline">留言</i></a>
                    </li>
                    <li class="nav-item col-sm-3">
                        <i class="mdi mdi-map-marker" style="color: #dc3545; font-size: 25px;"></i>
                        <a href="ditu.aspx" class="text-black-50 dz">地址:湖南安全技术职业学院

                        </a>

                    </li>
                    <li>
                        <a href="#offcanvasExample" class="btn btn-danger" id="grzx" data-bs-toggle="offcanvas" role="button" aria-controls="offcanvasExample">个人中心</a>
                    </li>
                </ul>
            </div>
        <div class="offcanvas offcanvas-start " style="width: 320px;" tabindex="-1" id="offcanvasExample" aria-labelledby="offcanvasExampleLabel">
               
                <div class="offcanvas-header text-center">
                 <p ><img src="img/三轮图标透明.png" class="pic" /><span style="color:#a71c1c;">我的个人中心~用户:</span><%=Session["username"] %></p>
                    <br /> 

                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>


                <div class="sjh text-center " style="padding-top:6px;">
                   
                   <a href="update.aspx" style="text-decoration:none; color:#a71c1c;">修改用户信息</a><br />
                    <h1></h1>
                    <a href="CuiAccTable.aspx" style="text-decoration:none; color:#a71c1c;">查看商品订单</a><br />
                      <h1></h1>
                     <a href="AccountTable.aspx" style="text-decoration:none; color:#a71c1c;">查看包厢订单</a><br />
                      <h1></h1>
                      <a href="ShoppingCar_Add.aspx" style="text-decoration:none; color:#a71c1c;">我的购物车</a><br />
                      <h1></h1>
                   <a href="zhuye.aspx" style="text-decoration:none; color:#a71c1c;">退出登录</a>
                </div>
              
            </div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
            <div>
                <hr />
                <footer class="mt-auto" style="background-color:whitesmoke;">
                  
                    
                    <p class="lead text-black text-center"><img src="img/三轮图标透明.png" style="width:40px; text-align:center" /><br />店面:SanLun饭店  地址:湖南省长沙县湘龙街道.</p>
                    <p class="text-center">SanLunHotel 湘ICP证0666号</p>

                </footer>
            </div>
        </div>
    </form>
</body>
</html>
